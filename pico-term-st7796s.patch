diff --git a/variants/rpi_pico/platformio.ini b/variants/rpi_pico/platformio.ini
index 2e0f65f..ebdbe73 100644
--- a/variants/rpi_pico/platformio.ini
+++ b/variants/rpi_pico/platformio.ini
@@ -89,3 +89,39 @@ lib_deps = ${rpi_pico.lib_deps}
   adafruit/Adafruit GFX Library @ ^1.12.0
   adafruit/Adafruit ST7735 and ST7789 Library @ ^1.11.0
 lib_ignore = BLE
+
+; Same firmware on a 320x240 ST7796S panel (landscape). Wiring is the same pins as the ST7789 build;
+; SDO/MISO can stay unconnected. TFT_VIS_W/H is the area the UI uses; the library itself is fixed at 320x480.
+[env:Pico_companion_term_7796]
+extends = rpi_pico
+build_flags = ${rpi_pico.build_flags}
+  -I examples/companion_radio/ui-term
+  -D MAX_CONTACTS=100
+  -D MAX_GROUP_CHANNELS=8
+  -D ENABLE_USB_INTERFACE
+  -D PICO_TERM_UI
+  -D DISPLAY_CLASS=TermDisplay
+  -D TFT_ST7796S
+  -D TFT_SCK=18
+  -D TFT_MOSI=19
+  -D TFT_CS=17
+  -D TFT_DC=21
+  -D TFT_RST=13
+  -D TFT_BL=27
+  -D TFT_VIS_W=320
+  -D TFT_VIS_H=240
+  -D TFT_SPI_HZ=24000000
+  -D TERM_ROTATION=1
+  -D TERM_FONT_SCALE=2
+  -D TERM_BTN_PIN=6
+  -D PIN_VBAT_READ=26
+  -D ADC_MULTIPLIER=10230
+build_src_filter = ${rpi_pico.build_src_filter}
+  +<../examples/companion_radio/*.cpp>
+  +<../examples/companion_radio/ui-term/*.cpp>
+lib_deps = ${rpi_pico.lib_deps}
+  densaugeo/base64 @ ~1.4.0
+  adafruit/Adafruit GFX Library @ ^1.12.0
+  adafruit/Adafruit BusIO @ ^1.14.0
+  https://github.com/prenticedavid/Adafruit_ST7796S_kbv.git
+lib_ignore = BLE
